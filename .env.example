# Proton: Settings → All settings → IMAP/SMTP → SMTP tokens
# Host public (plan plătit + domeniu propriu): smtp.protonmail.ch
# Bridge pe același calculator: 127.0.0.1 și SMTP_ALLOW_INVALID_CERT=1
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_ALLOW_INVALID_CERT=1

# Identitate pentru cererile 544/2001 (nu se arată publicului)
MAIL_SENDER_NAME=
MAIL_SENDER_ADDRESS=
MAIL_SENDER_EMAIL=
MAIL_SENDER_PHONE=
